    {
      "item_id": "2277-149896-0026",
      "text": "THE LONG DRIZZLE HAD BEGUN PEDESTRIANS HAD TURNED UP COLLARS AND TROUSERS AT THE BOTTOM",
      "audio": "2277-149896-0026.wav",
      "group": "demo",
      "archive_member": "LibriSpeech/dev-clean/2277/149896/2277-149896-0026.flac",
      "flac_sha256": "3909a6c5ae93112518681fcbf0a74df43615a4f88bd6d5cd788775255296e3f6",
      "pcm_s16le_sha256": "9a3b52e0ead13b3bc9996d69b59f54a46fc6ee8d93d7fc68dfab0868f4a3ac20",
      "sample_rate": 16000
    },
    {
      "item_id": "2277-149896-0005",
      "text": "MANY LITTLE WRINKLES GATHERED BETWEEN HIS EYES AS HE CONTEMPLATED THIS AND HIS BROW MOISTENED",
      "audio": "2277-149896-0005.wav",
      "group": "demo",
      "archive_member": "LibriSpeech/dev-clean/2277/149896/2277-149896-0005.flac",
      "flac_sha256": "05013da97856ccce8ef62b3408643f144ae6b88d581731675fd1a70b03288849",
      "pcm_s16le_sha256": "2224c92faa71c83bb691af7272368d52b4e873d0ed761a049f7e2b7897d97014",
      "sample_rate": 16000
    },
    {
      "item_id": "2277-149896-0033",
      "text": "THEN HE RANG THE BELL NO ANSWER",
      "audio": "2277-149896-0033.wav",
      "group": "demo",
      "archive_member": "LibriSpeech/dev-clean/2277/149896/2277-149896-0033.flac",
      "flac_sha256": "23009ec1ed5c704bb4b1c0bc75953121f38b2a2136cf8380f98e512517427473",
      "pcm_s16le_sha256": "b6e5ce6d8725811423d82db3d043f3159e4654d89647fbb4e1fcfb0b829806e1",
      "sample_rate": 16000
    },
    {
      "item_id": "2277-149896-0006",
      "text": "HE COULD ARRANGE THAT SATISFACTORILY FOR CARRIE WOULD BE GLAD TO WAIT IF NECESSARY",
      "audio": "2277-149896-0006.wav",
      "group": "demo",
      "archive_member": "LibriSpeech/dev-clean/2277/149896/2277-149896-0006.flac",
      "flac_sha256": "3d63f01a67b524514d7bee6b966b58d4b6f18f6cfa1f92c847353b824593ee8c",
      "pcm_s16le_sha256": "a9880a0a40f8a375fb58aa8075012c1f1672753526e1ed8ca414ca51b2db8e8e",
      "sample_rate": 16000
    },
    {
      "item_id": "2277-149896-0018",
      "text": "HIS FIRST IMPULSE WAS TO WRITE BUT FOUR WORDS IN REPLY GO TO THE DEVIL",
      "audio": "2277-149896-0018.wav",
      "group": "demo",
      "archive_member": "LibriSpeech/dev-clean/2277/149896/2277-149896-0018.flac",
      "flac_sha256": "6a52810a9b4656d86ef50cda41415f6d242e43939e0c501b9a02c63b9a869461",
      "pcm_s16le_sha256": "7313a557a0aa00ef6904e66e799ab87bde4412f0ddf13d3fd174bcba6c8c3315",
      "sample_rate": 16000
    },
    {
      "item_id": "2277-149896-0034",
      "text": "HE RANG AGAIN THIS TIME HARDER STILL NO ANSWER",
      "audio": "2277-149896-0034.wav",
      "group": "demo",
